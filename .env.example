# Copia in .env e personalizza. Tutto funziona anche senza HF_TOKEN.

# Provider di generazione: hf_remote (default, Mac senza GPU) | local (GPU CUDA) | procedural (offline)
GEN_PROVIDER=hf_remote

# Token Hugging Face (https://huggingface.co/settings/tokens). Facoltativo ma consigliato:
# più quota GPU sugli Space (Pixal3D ne usa parecchia) e FLUX via Inference Providers.
HF_TOKEN=

# Modello immagine->3D predefinito: pixal3d | trellis2 | step1x-3d | hunyuan3d-2.1 | hunyuan3d-2mv | trellis
# (hunyuan3d-*: licenza Tencent NON valida nell'Unione Europea, Italia inclusa)
HF_SHAPE_MODEL=pixal3d
# Se lo Space del modello scelto non risponde (quota, pausa, API cambiata) si passa a questo.
# "none" per disattivare.
HF_FALLBACK_MODEL=trellis2

# Space Hugging Face usati da hf_remote (puoi puntare a un tuo duplicato)
HF_SPACE_FLUX=black-forest-labs/FLUX.1-schnell
HF_FLUX_MODEL=black-forest-labs/FLUX.1-schnell
HF_SPACE_PIXAL3D=TencentARC/Pixal3D
HF_SPACE_TRELLIS2=microsoft/TRELLIS.2
HF_SPACE_HUNYUAN21=tencent/Hunyuan3D-2.1
HF_SPACE_STEP1X=stepfun-ai/Step1X-3D
HF_SPACE_HUNYUAN2MV=tencent/Hunyuan3D-2mv
HF_SPACE_TRELLIS=trellis-community/TRELLIS
HF_TIMEOUT_S=600

# local: modello 3D in locale (pixal3d | trellis2 | hunyuan3d-2.1)
LOCAL_SHAPE_MODEL=pixal3d

# Varie. DATA_DIR relativo = relativo alla radice del repository.
DATA_DIR=./backend/data
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_WORKERS=2
